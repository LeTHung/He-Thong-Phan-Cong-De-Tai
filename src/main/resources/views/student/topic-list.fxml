<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.ptit.doancnpm.controller.student.TopicListController"
            styleClass="student-root">

    <top>
        <HBox styleClass="student-topbar" alignment="CENTER_LEFT" spacing="18">
            <HBox styleClass="brand-box">
                <Label text="UT" styleClass="brand-logo brand-logo-text"/>
                <Label text="UniTopics" styleClass="brand-name"/>
            </HBox>

            <Button text="Trang chủ" styleClass="nav-link" onAction="#handleBackDashboard"/>
            <Button text="Danh sách đề tài" styleClass="nav-link-active"/>
            <Button text="Đề tài đã chọn" styleClass="nav-link" onAction="#handleShowMyRegistration"/>

            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblUserInfo" styleClass="user-chip-name"/>
            <Button text="Đăng xuất" styleClass="btn-outline" onAction="#handleLogout"/>
        </HBox>
    </top>

    <center>
        <HBox styleClass="student-content" spacing="22">
            <VBox spacing="18" HBox.hgrow="ALWAYS">
                <VBox styleClass="student-hero" spacing="10">
                    <Label text="Danh sách đề tài" styleClass="student-hero-title"/>
                    <Label text="Xem các đề tài còn chỗ trong lớp học phần của bạn, chọn một đề tài rồi đăng ký."
                           styleClass="student-hero-desc" wrapText="true"/>
                    <Label fx:id="lblPeriod" text="" styleClass="badge badge-info"/>
                </VBox>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <TextField fx:id="txtSearch" promptText="Tìm theo mã hoặc tên đề tài..."
                               onAction="#handleSearch" HBox.hgrow="ALWAYS"/>
                    <CheckBox fx:id="chkOnlyAvailable" text="Chỉ còn chỗ" onAction="#handleSearch"/>
                    <Button text="Tìm" styleClass="btn-secondary" onAction="#handleSearch"/>
                    <Button text="Làm mới" styleClass="btn-outline" onAction="#handleRefresh"/>
                </HBox>

                <VBox styleClass="student-info-card" spacing="12" VBox.vgrow="ALWAYS">
                    <Label text="Đề tài trong lớp học phần" styleClass="card-title"/>
                    <TableView fx:id="tblTopics" prefHeight="380" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colCode" text="Mã ĐT" prefWidth="90"/>
                            <TableColumn fx:id="colName" text="Tên đề tài" prefWidth="300"/>
                            <TableColumn fx:id="colSlots" text="Số lượng" prefWidth="90"/>
                            <TableColumn fx:id="colRemaining" text="Còn lại" prefWidth="80"/>
                            <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="110"/>
                            <TableColumn fx:id="colRegistered" text="Đăng ký" prefWidth="110"/>
                        </columns>
                    </TableView>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button text="Xem chi tiết" styleClass="btn-outline" onAction="#handleViewDetail"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnRegister" text="Đăng ký đề tài đã chọn" styleClass="btn-primary" onAction="#handleRegister"/>
                    </HBox>

                    <Label fx:id="lblMessage" text="" styleClass="body-muted" wrapText="true"/>
                </VBox>
            </VBox>

            <VBox styleClass="student-sidebar" spacing="16">
                <VBox styleClass="student-info-card" spacing="10">
                    <Label text="Thông tin sinh viên" styleClass="card-title"/>
                    <Label fx:id="lblStudentName" text="—" styleClass="selected-topic-title" wrapText="true"/>
                    <Label fx:id="lblStudentCode" text="MSSV: —" styleClass="body-muted"/>
                    <Label fx:id="lblStudentClass" text="Lớp: —" styleClass="body-muted"/>
                    <Label fx:id="lblCourseName" text="Lớp HP: —" styleClass="body-muted" wrapText="true"/>
                </VBox>

                <VBox styleClass="selected-topic-card" spacing="10">
                    <Label text="Gợi ý" styleClass="card-title"/>
                    <Label text="Mỗi sinh viên chỉ đăng ký được 1 đề tài trong một lớp học phần. Bạn có thể hủy và đăng ký lại khi cổng đăng ký còn mở."
                           styleClass="body-muted" wrapText="true"/>
                    <Button text="Xem đề tài đã chọn" styleClass="btn-outline" maxWidth="Infinity"
                            onAction="#handleShowMyRegistration"/>
                </VBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>
