<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.ptit.doancnpm.controller.student.RegistrationHistoryController"
            styleClass="student-root">

    <top>
        <HBox styleClass="student-topbar" alignment="CENTER_LEFT" spacing="18">
            <HBox styleClass="brand-box">
                <Label text="UT" styleClass="brand-logo brand-logo-text"/>
                <Label text="UniTopics" styleClass="brand-name"/>
            </HBox>

            <Button text="Trang chủ" styleClass="nav-link" onAction="#handleBackDashboard"/>
            <Button text="Danh sách đề tài" styleClass="nav-link" onAction="#handleShowTopicList"/>
            <Button text="Đề tài đã chọn" styleClass="nav-link" onAction="#handleShowMyRegistration"/>
            <Button text="Lịch sử" styleClass="nav-link-active"/>

            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblUserInfo" styleClass="user-chip-name"/>
            <Button text="Thông tin cá nhân" styleClass="nav-link" onAction="#handleShowProfile"/>
            <Button text="Đổi mật khẩu" styleClass="nav-link" onAction="#handleShowChangePassword"/>
            <Button text="Đăng xuất" styleClass="btn-outline" onAction="#handleLogout"/>
        </HBox>
    </top>

    <center>
        <VBox styleClass="student-content" spacing="18">
            <VBox styleClass="student-hero" spacing="10">
                <Label text="Lịch sử đăng ký" styleClass="student-hero-title"/>
                <Label text="Toàn bộ các lần đăng ký, hủy đăng ký và phân công đề tài của bạn, mới nhất ở trên."
                       styleClass="student-hero-desc" wrapText="true"/>
            </VBox>

            <VBox styleClass="student-info-card" spacing="12" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Nhật ký thao tác" styleClass="card-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Làm mới" styleClass="btn-outline" onAction="#handleRefresh"/>
                </HBox>

                <TableView fx:id="tblHistory" prefHeight="420" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colTime" text="Thời điểm" prefWidth="140"/>
                        <TableColumn fx:id="colAction" text="Hành động" prefWidth="150"/>
                        <TableColumn fx:id="colCode" text="Mã ĐT" prefWidth="80"/>
                        <TableColumn fx:id="colName" text="Tên đề tài" prefWidth="260"/>
                        <TableColumn fx:id="colClass" text="Lớp HP" prefWidth="140"/>
                        <TableColumn fx:id="colMode" text="Hình thức" prefWidth="160"/>
                        <TableColumn fx:id="colReason" text="Lý do" prefWidth="200"/>
                    </columns>
                </TableView>

                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Label fx:id="lblPageInfo" text="Trang 1/1" styleClass="body-muted"/>
                    <Button fx:id="btnPrevPage" text="‹ Trước" styleClass="btn-outline" onAction="#handlePrevPage"/>
                    <Button fx:id="btnNextPage" text="Sau ›" styleClass="btn-outline" onAction="#handleNextPage"/>
                </HBox>

                <Label fx:id="lblMessage" text="" styleClass="body-muted" wrapText="true"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
