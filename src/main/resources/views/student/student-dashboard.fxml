<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.ptit.doancnpm.controller.student.StudentDashboardController"
            styleClass="student-root">

    <top>
        <HBox styleClass="student-topbar" alignment="CENTER_LEFT" spacing="18">
            <HBox styleClass="brand-box">
                <Label text="UT" styleClass="brand-logo brand-logo-text"/>
                <Label text="UniTopics" styleClass="brand-name"/>
            </HBox>

            <Button text="Trang chủ" styleClass="nav-link-active"/>
            <Button text="Danh sách đề tài" styleClass="nav-link" onAction="#handleShowTopicList"/>
            <Button text="Đề tài đã chọn" styleClass="nav-link" onAction="#handleShowMyRegistration"/>
            <Button text="Lịch sử" styleClass="nav-link" onAction="#handleShowHistory"/>

            <Region HBox.hgrow="ALWAYS"/>

            <StackPane>
                <Button fx:id="btnNotifBell" styleClass="notif-bell" onAction="#handleToggleNotifications">
                    <graphic>
                        <SVGPath styleClass="notif-bell-icon"
                                 content="M12 2c-1.1 0-2 .9-2 2v.29C7.03 5.17 5 7.9 5 11v5l-2 2v1h18v-1l-2-2v-5c0-3.1-2.03-5.83-5-6.71V4c0-1.1-.9-2-2-2zm0 20c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2z"/>
                    </graphic>
                </Button>
                <Label fx:id="lblNotifCount" text="" styleClass="notif-count"
                       StackPane.alignment="TOP_RIGHT" mouseTransparent="true"/>
            </StackPane>

            <Label fx:id="lblUserInfo" styleClass="user-chip-name"/>
            <Button text="Thông tin cá nhân" styleClass="nav-link" onAction="#handleShowProfile"/>
            <Button text="Đổi mật khẩu" styleClass="nav-link" onAction="#handleShowChangePassword"/>
            <Button text="Đăng xuất" styleClass="btn-outline" onAction="#handleLogout"/>
        </HBox>
    </top>

    <center>
        <HBox styleClass="student-content" spacing="22">
            <VBox spacing="20" HBox.hgrow="ALWAYS">
                <VBox styleClass="student-hero" spacing="10">
                    <Label fx:id="lblWelcome" text="Đăng ký đề tài môn học" styleClass="student-hero-title"
                           wrapText="true"/>
                    <Label text="Xem danh sách đề tài, kiểm tra số chỗ còn lại và đăng ký đề tài phù hợp với nhóm của bạn."
                           styleClass="student-hero-desc" wrapText="true"/>
                    <HBox spacing="10">
                        <Label fx:id="lblCourseBadge" text="—" styleClass="badge badge-info"/>
                        <Label fx:id="lblPeriodBadge" text="—" styleClass="badge badge-info"/>
                    </HBox>
                </VBox>

                <VBox styleClass="student-info-card" spacing="14">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label text="Tổng quan đăng ký" styleClass="card-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Lớp học phần:" styleClass="body-muted"/>
                        <ComboBox fx:id="cboClass" prefWidth="240" onAction="#handleSelectClass"/>
                    </HBox>
                    <HBox spacing="18">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label fx:id="lblStatTotal" text="0" styleClass="current-course-value"/>
                            <Label text="Đề tài trong lớp" styleClass="body-muted"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label fx:id="lblStatAvailable" text="0" styleClass="current-course-value"/>
                            <Label text="Đề tài còn chỗ" styleClass="body-muted"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label fx:id="lblStatRegistered" text="0" styleClass="current-course-value"/>
                            <Label text="Đề tài đã đăng ký" styleClass="body-muted"/>
                        </VBox>
                    </HBox>

                    <Label fx:id="lblMessage" text="" styleClass="body-muted" wrapText="true"/>

                    <HBox spacing="10">
                        <Button text="Xem danh sách đề tài" styleClass="btn-primary" onAction="#handleShowTopicList"/>
                        <Button text="Đề tài đã chọn" styleClass="btn-outline" onAction="#handleShowMyRegistration"/>
                        <Button text="Lịch sử đăng ký" styleClass="btn-outline" onAction="#handleShowHistory"/>
                    </HBox>
                </VBox>
            </VBox>

            <VBox styleClass="student-sidebar" spacing="16">
                <VBox styleClass="student-info-card" spacing="10">
                    <Label text="Thông tin sinh viên" styleClass="card-title"/>
                    <Label fx:id="lblStudentName" text="—" styleClass="selected-topic-title" wrapText="true"/>
                    <Label fx:id="lblStudentCode" text="MSSV: —" styleClass="body-muted"/>
                    <Label fx:id="lblStudentClass" text="Lớp: —" styleClass="body-muted"/>
                    <Label fx:id="lblStudentCourse" text="Lớp HP: —" styleClass="body-muted" wrapText="true"/>
                    <Button text="Xem thông tin cá nhân" styleClass="btn-outline" maxWidth="Infinity"
                            onAction="#handleShowProfile"/>
                </VBox>

                <VBox styleClass="selected-topic-card" spacing="10">
                    <Label text="Đề tài đã đăng ký" styleClass="card-title"/>
                    <Label fx:id="lblRegisteredTopic" text="Chưa đăng ký đề tài nào"
                           styleClass="selected-topic-title" wrapText="true"/>
                    <Label fx:id="lblRegisteredStatus" text="" styleClass="badge badge-info"/>
                    <Button text="Đề tài đã chọn" styleClass="btn-outline" maxWidth="Infinity"
                            onAction="#handleShowMyRegistration"/>
                </VBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>
