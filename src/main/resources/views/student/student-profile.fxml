<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.ptit.doancnpm.controller.student.StudentProfileController"
            styleClass="student-root">

    <top>
        <HBox styleClass="student-topbar" alignment="CENTER_LEFT" spacing="18">
            <HBox styleClass="brand-box">
                <Label text="UT" styleClass="brand-logo brand-logo-text"/>
                <Label text="UniTopics" styleClass="brand-name"/>
            </HBox>

            <Button text="Trang chủ" styleClass="nav-link" onAction="#handleBackDashboard"/>
            <Button text="Danh sách đề tài" styleClass="nav-link" onAction="#handleShowTopicList"/>
            <Button text="Đề tài đã chọn" styleClass="nav-link" onAction="#handleShowMyRegistration"/>
            <Button text="Lịch sử" styleClass="nav-link" onAction="#handleShowHistory"/>

            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblUserInfo" styleClass="user-chip-name"/>
            <Button text="Thông tin cá nhân" styleClass="nav-link-active"/>
            <Button text="Đổi mật khẩu" styleClass="nav-link" onAction="#handleShowChangePassword"/>
            <Button text="Đăng xuất" styleClass="btn-outline" onAction="#handleLogout"/>
        </HBox>
    </top>

    <center>
        <StackPane styleClass="student-content">
            <VBox styleClass="student-info-card" spacing="16" maxWidth="560" maxHeight="-Infinity">
                <Label text="Thông tin cá nhân" styleClass="student-hero-title"/>
                <Label text="Hồ sơ sinh viên của bạn trong hệ thống. Liên hệ giáo vụ nếu thông tin chưa chính xác."
                       styleClass="student-hero-desc" wrapText="true"/>

                <GridPane hgap="16" vgap="12">
                    <Label text="Họ và tên:" styleClass="body-muted" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <Label fx:id="lblName" text="—" styleClass="current-course-value" wrapText="true"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="MSSV:" styleClass="body-muted" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <Label fx:id="lblCode" text="—" styleClass="current-course-value"
                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Email:" styleClass="body-muted" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <Label fx:id="lblEmail" text="—" styleClass="current-course-value" wrapText="true"
                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <Label text="Lớp sinh hoạt:" styleClass="body-muted" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <Label fx:id="lblClass" text="—" styleClass="current-course-value"
                           GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                    <Label text="Khóa học:" styleClass="body-muted" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                    <Label fx:id="lblCourseYear" text="—" styleClass="current-course-value"
                           GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                    <Label text="Ngành:" styleClass="body-muted" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                    <Label fx:id="lblMajor" text="—" styleClass="current-course-value" wrapText="true"
                           GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                    <Label text="Lớp học phần đang học:" styleClass="body-muted"
                           GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                    <Label fx:id="lblCourseSection" text="—" styleClass="current-course-value" wrapText="true"
                           GridPane.columnIndex="1" GridPane.rowIndex="6"/>
                </GridPane>

                <Label fx:id="lblMessage" text="" styleClass="body-muted" wrapText="true"/>

                <HBox spacing="10">
                    <Button text="Về trang chủ" styleClass="btn-primary" onAction="#handleBackDashboard"/>
                    <Button text="Đổi mật khẩu" styleClass="btn-outline" onAction="#handleShowChangePassword"/>
                </HBox>

                <padding>
                    <Insets top="24" right="24" bottom="24" left="24"/>
                </padding>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
