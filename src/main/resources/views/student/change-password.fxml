<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.ptit.doancnpm.controller.student.ChangePasswordController"
            styleClass="student-root">

    <top>
        <HBox styleClass="student-topbar" alignment="CENTER_LEFT" spacing="18">
            <HBox styleClass="brand-box">
                <Label text="UT" styleClass="brand-logo brand-logo-text"/>
                <Label text="UniTopics" styleClass="brand-name"/>
            </HBox>

            <Button text="Quay lại" styleClass="nav-link" onAction="#handleBack"/>

            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblUserInfo" styleClass="user-chip-name"/>
            <Button text="Đăng xuất" styleClass="btn-outline" onAction="#handleLogout"/>
        </HBox>
    </top>

    <center>
        <StackPane styleClass="student-content">
            <VBox styleClass="student-info-card" spacing="14" maxWidth="460" maxHeight="-Infinity">
                <Label text="Đổi mật khẩu" styleClass="student-hero-title"/>
                <Label text="Nhập mật khẩu hiện tại và mật khẩu mới (tối thiểu 6 ký tự)."
                       styleClass="student-hero-desc" wrapText="true"/>

                <VBox spacing="6">
                    <Label text="Mật khẩu hiện tại" styleClass="caption-strong"/>
                    <PasswordField fx:id="txtOld" promptText="Mật khẩu hiện tại"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Mật khẩu mới" styleClass="caption-strong"/>
                    <PasswordField fx:id="txtNew" promptText="Mật khẩu mới"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Xác nhận mật khẩu mới" styleClass="caption-strong"/>
                    <PasswordField fx:id="txtConfirm" promptText="Nhập lại mật khẩu mới"/>
                </VBox>

                <Label fx:id="lblMessage" text="" styleClass="body-muted" wrapText="true"/>

                <HBox spacing="10">
                    <Button text="Lưu mật khẩu" styleClass="btn-primary" onAction="#handleSave"/>
                    <Button text="Quay lại" styleClass="btn-outline" onAction="#handleBack"/>
                </HBox>

                <padding>
                    <Insets top="24" right="24" bottom="24" left="24"/>
                </padding>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
