<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.ptit.doancnpm.controller.admin.StudentImportController"
            styleClass="admin-root">

    <left>
        <VBox styleClass="side-bar" prefWidth="270" spacing="8">
            <HBox styleClass="side-brand">
                <Label text="PT" styleClass="side-logo"/>
                <VBox>
                    <Label text="PTIT Topic" styleClass="side-title"/>
                    <Label text="Admin Console" styleClass="side-subtitle"/>
                </VBox>
            </HBox>

            <Label text="QUẢN TRỊ" styleClass="side-section"/>
            <Button text="Dashboard" styleClass="side-menu" maxWidth="Infinity" onAction="#handleBackDashboard"/>
            <Button text="Quản lý tài khoản" styleClass="side-menu" maxWidth="Infinity" onAction="#handleShowAccounts"/>
            <Button text="Môn học" styleClass="side-menu" maxWidth="Infinity" onAction="#handleShowSubjects"/>
            <Button text="Học kỳ" styleClass="side-menu" maxWidth="Infinity" onAction="#handleShowSemesters"/>
            <Button text="Lớp học phần" styleClass="side-menu" maxWidth="Infinity" onAction="#handleShowCourseSections"/>
            <Button text="Import sinh viên" styleClass="side-menu-active" maxWidth="Infinity"/>
            <Button text="Báo cáo" styleClass="side-menu" maxWidth="Infinity" onAction="#handleShowReports"/>

            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Đổi mật khẩu" styleClass="side-password" maxWidth="Infinity" onAction="#handleShowChangePassword"/>
            <Button text="Đăng xuất" styleClass="side-logout" maxWidth="Infinity" onAction="#handleLogout"/>
        </VBox>
    </left>

    <center>
        <VBox styleClass="dashboard-content" spacing="22">
            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox>
                    <Label text="Sinh viên lớp học phần" styleClass="screen-title"/>
                    <Label text="Chọn lớp học phần, sau đó thêm hoặc rút sinh viên ngay trên bảng." styleClass="screen-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblUserInfo" styleClass="user-pill"/>
            </HBox>

            <VBox styleClass="main-card" spacing="12" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Danh sách sinh viên trong lớp" styleClass="card-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="+ Thêm sinh viên" styleClass="btn-primary" onAction="#handleAddStudent"/>
                        <Button fx:id="btnWithdraw" text="Rút khỏi lớp" styleClass="btn-warning" onAction="#handleWithdrawStudent"/>
                        <Button text="Import Excel" styleClass="btn-outline" onAction="#handleImportExcel"/>
                        <Button text="Làm mới" styleClass="btn-outline" onAction="#handleRefreshStudents"/>
                    </HBox>

                    <VBox spacing="6">
                        <Label text="Lớp học phần" styleClass="caption-strong"/>
                        <ComboBox fx:id="cboCourseSection" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="6">
                        <Label text="Tìm kiếm" styleClass="caption-strong"/>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <TextField fx:id="txtSearch" promptText="Tìm mã sinh viên, họ tên hoặc email..." HBox.hgrow="ALWAYS"/>
                            <Button text="Xóa tìm kiếm" styleClass="btn-outline" onAction="#handleClearFilters"/>
                        </HBox>
                    </VBox>

                    <TableView fx:id="tblStudents" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colStt" text="STT" prefWidth="50"/>
                            <TableColumn fx:id="colStudentCode" text="Mã sinh viên" prefWidth="130"/>
                            <TableColumn fx:id="colFullName" text="Họ tên" prefWidth="190"/>
                            <TableColumn fx:id="colEmail" text="Email" prefWidth="220"/>
                            <TableColumn fx:id="colClassName" text="Lớp sinh hoạt" prefWidth="130"/>
                            <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="110"/>
                            <TableColumn fx:id="colNote" text="Ghi chú" prefWidth="180"/>
                        </columns>
                    </TableView>
                    <Label fx:id="lblMessage" text="" styleClass="body-muted" wrapText="true"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
