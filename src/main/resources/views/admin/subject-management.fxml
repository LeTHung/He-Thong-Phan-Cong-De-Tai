<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.ptit.doancnpm.controller.admin.SubjectManagementController"
            styleClass="admin-root">

    <left>
        <VBox styleClass="side-bar" prefWidth="270" spacing="8">
            <HBox styleClass="side-brand">
                <Label text="PT" styleClass="side-logo"/>
                <VBox>
                    <Label text="PTIT Topic" styleClass="side-title"/>
                    <Label text="Admin Console" styleClass="side-subtitle"/>
                </VBox>
            </HBox>

            <Label text="QUẢN TRỊ" styleClass="side-section"/>
            <Button text="Dashboard" styleClass="side-menu" maxWidth="Infinity" onAction="#handleBackDashboard"/>
            <Button text="Quản lý tài khoản" styleClass="side-menu" maxWidth="Infinity" onAction="#handleShowAccounts"/>
            <Button text="Môn học" styleClass="side-menu-active" maxWidth="Infinity"/>
            <Button text="Học kỳ" styleClass="side-menu" maxWidth="Infinity" onAction="#handleShowSemesters"/>
            <Button text="Lớp học phần" styleClass="side-menu" maxWidth="Infinity" onAction="#handleShowCourseSections"/>
            <Button text="Import sinh viên" styleClass="side-menu" maxWidth="Infinity" onAction="#handleShowStudentImport"/>
            <Button text="Báo cáo" styleClass="side-menu" maxWidth="Infinity" onAction="#handleShowReports"/>

            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Đăng xuất" styleClass="side-logout" maxWidth="Infinity" onAction="#handleLogout"/>
        </VBox>
    </left>

    <center>
        <VBox styleClass="dashboard-content" spacing="22">
            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox>
                    <Label text="Quản lý môn học" styleClass="screen-title"/>
                    <Label text="Chọn môn học trên bảng để sửa hoặc thay đổi trạng thái sử dụng." styleClass="screen-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblUserInfo" styleClass="user-pill"/>
            </HBox>

            <VBox styleClass="main-card" spacing="12" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Danh sách môn học" styleClass="card-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="+ Thêm" styleClass="btn-primary" onAction="#handleAddSubject"/>
                        <Button fx:id="btnEdit" text="Sửa" styleClass="btn-secondary" onAction="#handleUpdateSubject"/>
                        <Button text="Làm mới" styleClass="btn-outline" onAction="#handleRefreshSubjects"/>
                    </HBox>
                    <TableView fx:id="tblSubjects" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colCode" text="Mã môn" prefWidth="180"/>
                            <TableColumn fx:id="colName" text="Tên môn học" prefWidth="430"/>
                            <TableColumn fx:id="colCredits" text="Tín chỉ" prefWidth="130"/>
                            <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="220"/>
                        </columns>
                    </TableView>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Button fx:id="btnActivate" text="Mở sử dụng" styleClass="btn-outline" onAction="#handleActivateSubject"/>
                        <Button fx:id="btnDeactivate" text="Ngừng sử dụng" styleClass="btn-warning" onAction="#handleDeactivateSubject"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="Mẹo: nhấp đúp một dòng để sửa" styleClass="body-muted"/>
                    </HBox>
                    <Label fx:id="lblMessage" text="" styleClass="body-muted" wrapText="true"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
