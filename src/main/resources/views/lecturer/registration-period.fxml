<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.ptit.doancnpm.controller.lecturer.RegistrationPeriodController"
            styleClass="lecturer-root">

    <left>
        <VBox styleClass="side-bar lecturer-side" prefWidth="270" spacing="8">
            <HBox styleClass="side-brand">
                <Label text="PT" styleClass="side-logo"/>
                <VBox>
                    <Label text="PTIT Topic" styleClass="side-title"/>
                    <Label text="Lecturer Workspace" styleClass="side-subtitle"/>
                </VBox>
            </HBox>
            <Label text="GIẢNG VIÊN" styleClass="side-section"/>
            <Button text="Dashboard" styleClass="side-menu" maxWidth="Infinity" onAction="#handleBack"/>
            <Button text="Lớp được phân công" styleClass="side-menu" maxWidth="Infinity" onAction="#handleBack"/>
            <Button text="Ngân hàng đề tài" styleClass="side-menu" maxWidth="Infinity" onAction="#handleBack"/>
            <Button text="Gán đề tài vào lớp" styleClass="side-menu" maxWidth="Infinity" onAction="#handleBack"/>
            <Button text="Mở cổng đăng ký" styleClass="side-menu-active" maxWidth="Infinity"/>
            <Button text="Kết quả đăng ký" styleClass="side-menu" maxWidth="Infinity" onAction="#handleBack"/>
            <Button text="Chốt danh sách" styleClass="side-menu" maxWidth="Infinity" onAction="#handleBack"/>
            <Region VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>

    <center>
        <VBox styleClass="dashboard-content" spacing="18">
            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox>
                    <Label text="Đợt đăng ký" styleClass="screen-title"/>
                    <Label text="Mở và quản lý cổng đăng ký đề tài cho lớp học phần." styleClass="screen-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="← Quay lại" styleClass="btn-outline" onAction="#handleBack"/>
            </HBox>

            <!-- Chọn lớp và trạng thái hiện tại -->
            <VBox styleClass="main-card" spacing="14">
                <Label text="Lớp học phần" styleClass="card-title"/>
                <HBox spacing="14" alignment="CENTER_LEFT">
                    <VBox spacing="4">
                        <Label text="Chọn lớp:"/>
                        <ComboBox fx:id="cbSection" prefWidth="320"/>
                    </VBox>
                    <VBox spacing="4">
                        <Label text="Trạng thái cổng:"/>
                        <Label fx:id="lblStatus" text="—" style="-fx-font-weight:bold; -fx-font-size:14;"/>
                    </VBox>
                </HBox>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Thông tin đợt hiện tại:" styleClass="body-muted"/>
                    <Label fx:id="lblCurrentPeriodInfo" text="—" styleClass="body-muted"/>
                </HBox>
            </VBox>

            <Separator/>

            <!-- Form mở đợt đăng ký -->
            <VBox styleClass="main-card" spacing="14">
                <Label text="Mở / Cập nhật đợt đăng ký" styleClass="card-title"/>
                <HBox spacing="14" alignment="CENTER_LEFT">
                    <VBox spacing="4">
                        <Label text="Ngày bắt đầu:"/>
                        <DatePicker fx:id="dpStart" prefWidth="160"/>
                    </VBox>
                    <VBox spacing="4">
                        <Label text="Giờ bắt đầu:"/>
                        <TextField fx:id="txtStartTime" prefWidth="100"/>
                    </VBox>
                    <VBox spacing="4">
                        <Label text="Ngày kết thúc:"/>
                        <DatePicker fx:id="dpEnd" prefWidth="160"/>
                    </VBox>
                    <VBox spacing="4">
                        <Label text="Giờ kết thúc:"/>
                        <TextField fx:id="txtEndTime" prefWidth="100"/>
                    </VBox>
                    <VBox spacing="4">
                        <Label text=" "/>
                        <Button fx:id="btnOpen" text="Mở cổng đăng ký" styleClass="btn-primary"
                                onAction="#handleOpen"/>
                    </VBox>
                </HBox>
                <Label text="Nếu đã có đợt đăng ký, thao tác này sẽ CẬP NHẬT thời gian và chuyển về trạng thái ĐANG MỞ."
                       styleClass="body-muted" wrapText="true"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
