<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.ptit.doancnpm.controller.lecturer.MyCourseSectionsController"
            styleClass="lecturer-root">

    <left>
        <VBox styleClass="side-bar" prefWidth="270" spacing="8">
            <HBox styleClass="side-brand">
                <Label text="PT" styleClass="side-logo"/>
                <VBox>
                    <Label text="PTIT Topic" styleClass="side-title"/>
                    <Label text="Lecturer Workspace" styleClass="side-subtitle"/>
                </VBox>
            </HBox>
            <Label text="GIẢNG VIÊN" styleClass="side-section"/>
            <Button text="Dashboard" styleClass="side-menu" maxWidth="Infinity" onAction="#handleBack"/>
            <Button text="Lớp được phân công" styleClass="side-menu-active" maxWidth="Infinity"/>
            <Button text="Ngân hàng đề tài" styleClass="side-menu" maxWidth="Infinity"
                    onAction="#handleNavTopicBank"/>
            <Button text="Gán đề tài vào lớp" styleClass="side-menu" maxWidth="Infinity"
                    onAction="#handleNavAssignTopic"/>
            <Button text="Mở cổng đăng ký" styleClass="side-menu" maxWidth="Infinity"
                    onAction="#handleNavRegistrationPeriod"/>
            <Button text="Kết quả &amp; phân công" styleClass="side-menu" maxWidth="Infinity"
                    onAction="#handleNavRegistrationResult"/>
            <Button text="Chốt danh sách" styleClass="side-menu" maxWidth="Infinity"
                    onAction="#handleNavFinalReport"/>
            <Region VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>

    <center>
        <VBox styleClass="dashboard-content" spacing="18">
            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox>
                    <Label text="Lớp học phần của tôi" styleClass="screen-title"/>
                    <Label text="Danh sách lớp học phần bạn đang phụ trách." styleClass="screen-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="← Quay lại" styleClass="btn-outline" onAction="#handleBack"/>
            </HBox>

            <HBox alignment="CENTER_LEFT">
                <Label fx:id="lblTotalSections" text="Tổng: 0 lớp học phần" styleClass="body-muted"/>
            </HBox>

            <VBox styleClass="main-card" spacing="12" VBox.vgrow="ALWAYS">
                <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colMaLop" text="Mã lớp" prefWidth="120"/>
                        <TableColumn fx:id="colTenLop" text="Tên lớp học phần" prefWidth="250"/>
                        <TableColumn fx:id="colMonHoc" text="Môn học" prefWidth="200"/>
                        <TableColumn fx:id="colHocKy" text="Học kỳ" prefWidth="150"/>
                        <TableColumn fx:id="colSoSV" text="Số SV" prefWidth="70"/>
                        <TableColumn fx:id="colTrangThaiDot" text="Đợt đăng ký" prefWidth="130"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
