<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.ptit.doancnpm.controller.lecturer.FinalReportController"
            styleClass="lecturer-root">

    <left>
        <VBox styleClass="side-bar lecturer-side" prefWidth="270" spacing="8">
            <HBox styleClass="side-brand">
                <Label text="PT" styleClass="side-logo"/>
                <VBox>
                    <Label text="PTIT Topic" styleClass="side-title"/>
                    <Label text="Lecturer Workspace" styleClass="side-subtitle"/>
                </VBox>
            </HBox>
            <Label text="GIẢNG VIÊN" styleClass="side-section"/>
            <Button text="Dashboard" styleClass="side-menu" maxWidth="Infinity" onAction="#handleBack"/>
            <Button text="Lớp được phân công" styleClass="side-menu" maxWidth="Infinity" onAction="#handleBack"/>
            <Button text="Ngân hàng đề tài" styleClass="side-menu" maxWidth="Infinity" onAction="#handleBack"/>
            <Button text="Gán đề tài vào lớp" styleClass="side-menu" maxWidth="Infinity" onAction="#handleBack"/>
            <Button text="Mở cổng đăng ký" styleClass="side-menu" maxWidth="Infinity" onAction="#handleBack"/>
            <Button text="Kết quả đăng ký" styleClass="side-menu" maxWidth="Infinity" onAction="#handleBack"/>
            <Button text="Chốt danh sách" styleClass="side-menu-active" maxWidth="Infinity"/>
            <Region VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>

    <center>
        <VBox styleClass="dashboard-content" spacing="18">
            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox>
                    <Label text="Báo cáo cuối kỳ — Chốt danh sách" styleClass="screen-title"/>
                    <Label text="Xem thống kê và chốt danh sách phân công đề tài." styleClass="screen-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="← Quay lại" styleClass="btn-outline" onAction="#handleBack"/>
            </HBox>

            <!-- Chọn lớp + thống kê -->
            <VBox styleClass="main-card" spacing="14">
                <HBox spacing="14" alignment="CENTER_LEFT">
                    <Label text="Lớp học phần:"/>
                    <ComboBox fx:id="cbSection" prefWidth="320"/>
                    <Label text="Trạng thái:" styleClass="body-muted"/>
                    <Label fx:id="lblStatusLabel" text="—" style="-fx-font-weight:bold;"/>
                </HBox>

                <HBox spacing="18">
                    <VBox styleClass="stat-card" prefWidth="160">
                        <Label text="Tổng SV" styleClass="stat-label"/>
                        <Label fx:id="lblTotalStudents" text="—" styleClass="stat-value"/>
                    </VBox>
                    <VBox styleClass="stat-card-blue" prefWidth="160">
                        <Label text="Đã có đề tài" styleClass="stat-label"/>
                        <Label fx:id="lblWithTopic" text="—" styleClass="stat-value"/>
                    </VBox>
                    <VBox styleClass="stat-card" prefWidth="160">
                        <Label text="Chưa có đề tài" styleClass="stat-label"/>
                        <Label fx:id="lblWithoutTopic" text="—" styleClass="stat-value"/>
                    </VBox>
                    <VBox styleClass="stat-card" prefWidth="160">
                        <Label text="Tổng đề tài" styleClass="stat-label"/>
                        <Label fx:id="lblTotalTopics" text="—" styleClass="stat-value"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnFinalize" text="Chốt danh sách" disable="true"
                            style="-fx-background-color:#e05c0a; -fx-text-fill:white; -fx-font-weight:bold; -fx-padding:10 20;"
                            onAction="#handleFinalize"/>
                </HBox>
            </VBox>

            <Separator/>

            <!-- Bảng báo cáo -->
            <VBox styleClass="main-card" spacing="12" VBox.vgrow="ALWAYS">
                <Label text="Danh sách phân công đề tài" styleClass="card-title"/>
                <TableView fx:id="tableReport" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colMaSV" text="Mã SV" prefWidth="120"/>
                        <TableColumn fx:id="colTenSV" text="Họ tên" prefWidth="200"/>
                        <TableColumn fx:id="colLopSH" text="Lớp SH" prefWidth="120"/>
                        <TableColumn fx:id="colMaDeTai" text="Mã đề tài" prefWidth="120"/>
                        <TableColumn fx:id="colTenDeTai" text="Tên đề tài" prefWidth="300"/>
                        <TableColumn fx:id="colHinhThuc" text="Hình thức" prefWidth="130"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
